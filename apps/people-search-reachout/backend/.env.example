# Never commit the real .env file.

HUNAR_API_KEY=
HUNAR_WEBHOOK_SECONDARY_KEYS=

# People Data Labs (https://www.peopledatalabs.com/) Person Search API key.
# Sign up for a free trial (works for this assignment: 1000 free credits/month).
PDL_API_KEY=
# If PDL_API_KEY is blank, the app runs in MOCK mode and returns realistic
# sample candidates so the reachout + dashboard flow can still be demoed.
PDL_MOCK_MODE=true

DATABASE_URL=sqlite:///./people_search.db
DEFAULT_VOICE_PERSONA=NEHA
DEFAULT_LANGUAGE=ENGLISH
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
