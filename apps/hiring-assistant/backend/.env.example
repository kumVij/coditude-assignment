# Never commit the real .env file. This file only documents required vars.

# Hunar Voice Agents API key (rotates every 3 days per assignment note) — keep secret.
HUNAR_API_KEY=

# Comma-separated list of additional/older Hunar API keys still valid for
# verifying webhook signatures during key rotation (optional).
HUNAR_WEBHOOK_SECONDARY_KEYS=

# SQLite by default; swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/hiring_assistant
DATABASE_URL=sqlite:///./hiring_assistant.db

DEFAULT_VOICE_PERSONA=NEHA
DEFAULT_LANGUAGE=ENGLISH
DEFAULT_TIMEZONE=Asia/Kolkata

# Frontend origin(s) allowed to call this API, comma separated
CORS_ORIGINS=http://localhost:3000

# Public HTTPS URL of THIS backend once deployed (used to build the Hunar
# webhook callback URL). Leave blank for local dev — the app will fall back
# to polling (GET /api/jobs/{id}/calls?refresh=true) instead of webhooks.
PUBLIC_BASE_URL=

# Production security settings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
PII_ENCRYPTION_KEY=
AUTH_REQUIRED=true
RATE_LIMIT=30/minute
QUEUE_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
AUTO_CREATE_SCHEMA=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
