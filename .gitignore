# Local secrets and environment overrides. Keep only *.env.example files tracked.
.env
.env.*
!.env.example
!.env.*.example

# Local runtime state
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
.venv/

# Node / Next.js
node_modules/
.next/

# Local logs and tooling output
*.log
.pytest_cache/
.mypy_cache/
